# Copy to vm2.env and replace all sample addresses with actual VM private IPs.
# 複製為 vm2.env，並將所有範例位址換成實際 VM 私有 IP。
VM_IP=192.168.64.12
ETCD_NAME=etcd-2
APP_VM_IP=192.168.64.11
PG_NODE_1_IP=192.168.64.12
PG_NODE_2_IP=192.168.64.13
ETCD_INITIAL_CLUSTER=etcd-1=http://192.168.64.11:2380,etcd-2=http://192.168.64.12:2380,etcd-3=http://192.168.64.13:2380
ETCD_INITIAL_CLUSTER_TOKEN=ha-postgresql-vm-lab
ETCD_HOSTS=192.168.64.11:2379,192.168.64.12:2379,192.168.64.13:2379
PATRONI_NAME=pg-node-1
PATRONI_SCOPE=ha-postgresql
POSTGRES_IMAGE=yuchen1226/postgres-patroni:18.6-patroni4.1.5
